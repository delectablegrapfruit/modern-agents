    <Compile Include="src\Config\AppSettings.cs" />
    <Compile Include="src\Config\SettingsStore.cs" />
    <Compile Include="src\Diagnostics.cs" />
    <Compile Include="src\ElevatedHelper.cs" />
    <Compile Include="src\Interop\Elevation.cs" />
    <Compile Include="src\Interop\NativeMethods.cs" />
    <Compile Include="src\Interop\TextEntry.cs" />
    <Compile Include="src\Library\CharacterFileInfo.cs" />
    <Compile Include="src\Library\CharacterLibrary.cs" />
