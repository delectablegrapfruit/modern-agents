{
  "name": "Books",
  "short_name": "Books",
  "description": "Offline reader modelled on Books for macOS.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#f0f0f2",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    { "action": "./index.html", "accept": { "application/epub+zip": [".epub"], "application/pdf": [".pdf"], "text/plain": [".txt"] } }
  ]
}
