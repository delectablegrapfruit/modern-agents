{
  "manifest_version": 3,
  "name": "Focus & Fix for YouTube",
  "version": "2.2.0",
  "description": "Hide YouTube's distractions, filter videos by keyword, channel or length, and fix ad-blocker playback hiccups.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "contextMenus", "webRequest"],
  "host_permissions": ["*://*.youtube.com/*", "*://*.googlevideo.com/*", "*://jnn-pa.googleapis.com/*", "*://www.google.com/js/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Focus & Fix for YouTube",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "commands": {
    "toggle-hiding": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Turn hiding on or off"
    },
    "pick-element": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Pick an element to hide"
    },
    "pause-15": {
      "description": "Pause hiding for 15 minutes"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["src/page.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["src/schema.js", "src/store.js", "src/picker.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
